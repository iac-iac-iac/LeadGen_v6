<UserControl x:Class="LeadGen.Controls.IntroOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="#06070D"
             Focusable="True">
    <UserControl.Resources>
        <!-- Стили букв для кинематографичного трекинга -->
        <Style x:Key="IntroLetterStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FF"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль неоновой линии сети -->
        <Style x:Key="NetworkLineStyle" TargetType="Line">
            <Setter Property="Stroke" Value="#302EE8D6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="StrokeDashArray" Value="6 6"/>
        </Style>

        <!-- Стиль неоновой светящейся точки -->
        <Style x:Key="NetworkDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF2EE8D6" Offset="0"/>
                        <GradientStop Color="#002EE8D6" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" CenterX="700" CenterY="450"/>
        </Grid.RenderTransform>

        <!-- Глубокое фоновое свечение позади всего -->
        <Grid IsHitTestVisible="False" Opacity="0.4">
            <Ellipse Width="600" Height="600" Fill="{StaticResource AuroraOrbPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BgPulsePurple" X="0" Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="500" Height="500" Fill="{StaticResource AuroraOrbTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BgPulseTeal" X="0" Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ФАЗА 1: Абстрактная сеть точек и линий -->
        <Grid x:Name="NetworkContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="400" IsHitTestVisible="False">
            <!-- Электрические линии, стягивающиеся к центру -->
            <Line x:Name="Line1" Style="{StaticResource NetworkLineStyle}" X1="80" Y1="100" X2="200" Y2="200"/>
            <Line x:Name="Line2" Style="{StaticResource NetworkLineStyle}" X1="330" Y1="120" X2="200" Y2="200"/>
            <Line x:Name="Line3" Style="{StaticResource NetworkLineStyle}" X1="300" Y1="320" X2="200" Y2="200"/>
            <Line x:Name="Line4" Style="{StaticResource NetworkLineStyle}" X1="90" Y1="310" X2="200" Y2="200"/>
            <Line x:Name="Line5" Style="{StaticResource NetworkLineStyle}" X1="60" Y1="200" X2="200" Y2="200"/>
            <Line x:Name="Line6" Style="{StaticResource NetworkLineStyle}" X1="250" Y1="70" X2="200" Y2="200"/>
            <Line x:Name="Line7" Style="{StaticResource NetworkLineStyle}" X1="320" Y1="220" X2="200" Y2="200"/>
            <Line x:Name="Line8" Style="{StaticResource NetworkLineStyle}" X1="160" Y1="340" X2="200" Y2="200"/>

            <!-- Светящиеся точки, летящие к центру -->
            <Ellipse x:Name="Dot1" Style="{StaticResource NetworkDotStyle}" Margin="76,96,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot2" Style="{StaticResource NetworkDotStyle}" Margin="326,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot3" Style="{StaticResource NetworkDotStyle}" Margin="296,316,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot4" Style="{StaticResource NetworkDotStyle}" Margin="86,306,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot5" Style="{StaticResource NetworkDotStyle}" Margin="56,196,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot6" Style="{StaticResource NetworkDotStyle}" Margin="246,66,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot7" Style="{StaticResource NetworkDotStyle}" Margin="316,216,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse x:Name="Dot8" Style="{StaticResource NetworkDotStyle}" Margin="156,336,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>

        <!-- ФАЗА 2: Векторный логотип (SVG) и вспышка -->
        <Grid x:Name="LogoContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="220" IsHitTestVisible="False" Margin="0,-80,0,0">
            <Ellipse x:Name="LogoGlow" Width="180" Height="180" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#902EE8D6" Offset="0"/>
                        <GradientStop Color="#001A4FD4" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Viewbox x:Name="IntroLogoHost" Width="168" Height="168" Opacity="0"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.2" ScaleY="0.2"/>
                </Viewbox.RenderTransform>
                <Viewbox.Effect>
                    <DropShadowEffect Color="#2EE8D6" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
                </Viewbox.Effect>
                <svgc:SvgViewbox Source="pack://application:,,,/Assets/app-icon.svg" Stretch="Uniform"/>
            </Viewbox>
        </Grid>

        <!-- ФАЗА 3: Кинематографичный трекинг букв L E A D G E N -->
        <Grid x:Name="TitleContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Буквы с индивидуальными трансформациями для трекинга -->
                <TextBlock x:Name="LetterL" Style="{StaticResource IntroLetterStyle}" Text="L">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransL"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterE" Style="{StaticResource IntroLetterStyle}" Text="E">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransE"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterA" Style="{StaticResource IntroLetterStyle}" Text="A">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransA"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterD" Style="{StaticResource IntroLetterStyle}" Text="D">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransD"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterG" Style="{StaticResource IntroLetterStyle}" Text="G">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransG"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterE2" Style="{StaticResource IntroLetterStyle}" Text="E">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransE2"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LetterN" Style="{StaticResource IntroLetterStyle}" Text="N">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TransN"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Консоль статусов инициализации системы -->
        <Grid x:Name="ConsoleContainer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="ConsoleLine" Text="[SYS] Initializing core..."
                           FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#45F4F6FF"
                           HorizontalAlignment="Center" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ConsoleTrans" Y="10"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Тонкий прогресс-бар инициализации -->
        <Border x:Name="IntroProgressBorder" Height="2" Width="180" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,94"
                Background="#08FFFFFF" Opacity="0" ClipToBounds="True">
            <Border x:Name="IntroProgressBar" Width="0" Height="2" CornerRadius="1" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left"/>
        </Border>

        <!-- Кнопка пропуска интро -->
        <Button x:Name="SkipBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,32"
                Click="OnSkipClick" Focusable="False" Opacity="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ПРОПУСТИТЬ" FontSize="10" FontWeight="SemiBold" Foreground="#80F4F6FF" VerticalAlignment="Center"/>
                            <Path Data="M1,2 L5,6 L1,10" Stroke="#50F4F6FF" StrokeThickness="1.5" Margin="8,0,0,0" Width="6" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#30FFFFFF"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2EE8D6" BlurRadius="12" ShadowDepth="0" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
