<Application x:Class="LeadGen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LeadGen.Helpers"
             xmlns:views="clr-namespace:LeadGen.Views"
             xmlns:vm="clr-namespace:LeadGen.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
            <helpers:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <helpers:FileNameConverter x:Key="FileNameConverter"/>
            <helpers:FileExtensionConverter x:Key="FileExtensionConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <helpers:ActivityIconGeometryConverter x:Key="ActivityIconGeometryConverter"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProcessingViewModel}">
                <views:ProcessingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LinkGeneratorViewModel}">
                <views:LinkGeneratorView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
