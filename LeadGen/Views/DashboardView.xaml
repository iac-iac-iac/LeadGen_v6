<UserControl x:Class="LeadGen.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:helpers="clr-namespace:LeadGen.Helpers"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,32">
        <StackPanel MaxWidth="1280">

            <!-- Hero header -->
            <Grid Margin="0,0,0,28"
                  helpers:Animation.StaggerIndex="0"
                  helpers:Animation.Entrance="BlurReveal">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F4F6FF" Offset="0"/>
                                <GradientStop Color="#C4B5FD" Offset="0.6"/>
                                <GradientStop Color="#2EE8D6" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        Дашборд
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Статистика обработки лидов и генерации ссылок"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="8"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Pipeline активен" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Content="↻  Обновить"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Period filter -->
            <Border Style="{StaticResource PremiumGlassCard}" Padding="12" Margin="0,0,0,24"
                    helpers:Animation.StaggerIndex="1"
                    helpers:Animation.Entrance="SlideUp">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PeriodChip}" Content="Сегодня" GroupName="Period"
                                 Command="{Binding SetPeriodCommand}" CommandParameter="Today" Margin="0,0,8,0">
                        <RadioButton.IsChecked>
                            <Binding Path="SelectedPeriod" Mode="OneWay"
                                     Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Today"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PeriodChip}" Content="7 дней" GroupName="Period"
                                 Command="{Binding SetPeriodCommand}" CommandParameter="Week" Margin="0,0,8,0">
                        <RadioButton.IsChecked>
                            <Binding Path="SelectedPeriod" Mode="OneWay"
                                     Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Week"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PeriodChip}" Content="30 дней" GroupName="Period"
                                 Command="{Binding SetPeriodCommand}" CommandParameter="Month" Margin="0,0,8,0">
                        <RadioButton.IsChecked>
                            <Binding Path="SelectedPeriod" Mode="OneWay"
                                     Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Month"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PeriodChip}" Content="90 дней" GroupName="Period"
                                 Command="{Binding SetPeriodCommand}" CommandParameter="Quarter" Margin="0,0,8,0">
                        <RadioButton.IsChecked>
                            <Binding Path="SelectedPeriod" Mode="OneWay"
                                     Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Quarter"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PeriodChip}" Content="Всё время" GroupName="Period"
                                 Command="{Binding SetPeriodCommand}" CommandParameter="All">
                        <RadioButton.IsChecked>
                            <Binding Path="SelectedPeriod" Mode="OneWay"
                                     Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="All"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Stat cards -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Files -->
                <Border x:Name="StatFilesCard" Margin="0,0,14,0" CornerRadius="20" BorderThickness="1" BorderBrush="#358B6CFF"
                        Background="{StaticResource StatCardPurpleBrush}" Padding="22" ClipToBounds="True"
                        helpers:Animation.InteractiveGlow="True"
                        helpers:Animation.InteractiveGlowColor="#8B6CFF"
                        helpers:Animation.InteractiveGlowSecondaryColor="#C4B5FD"
                        helpers:Animation.StaggerIndex="2"
                        helpers:Animation.Entrance="SlideUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="#8B6CFF"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-30,-30,0" Fill="#158B6CFF"/>
                        <Ellipse Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,10,10,0" Fill="#20FFFFFF"/>
                        <StackPanel>
                            <Path Style="{StaticResource StatIconPath}"
                                  Data="{StaticResource FolderIconGeometry}"
                                  Stroke="{StaticResource AccentPrimaryBrush}"/>
                            <TextBlock Text="Файлов обработано" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FilesProcessed}" FontSize="38" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource TrendBadge}" Background="#1A8B6CFF" BorderBrush="#408B6CFF">
                                <TextBlock Text="↑ активность" FontSize="10" Foreground="#B8A8FF"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rows -->
                <Border x:Name="StatRowsCard" Margin="0,0,14,0" CornerRadius="20" BorderThickness="1" BorderBrush="#352EE8D6"
                        Background="{StaticResource StatCardTealBrush}" Padding="22" ClipToBounds="True"
                        helpers:Animation.InteractiveGlow="True"
                        helpers:Animation.InteractiveGlowColor="#2EE8D6"
                        helpers:Animation.InteractiveGlowSecondaryColor="#7EEADB"
                        helpers:Animation.StaggerIndex="3"
                        helpers:Animation.Entrance="SlideUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25" Color="#2EE8D6"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-20,-20,0" Fill="#122EE8D6"/>
                        <StackPanel>
                            <Path Style="{StaticResource StatIconPath}"
                                  Data="{StaticResource ChartIconGeometry}"
                                  Stroke="{StaticResource AccentSecondaryBrush}"/>
                            <TextBlock Text="Строк / записей" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RowsProcessed}" FontSize="38" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource TrendBadge}" Background="#1A2EE8D6" BorderBrush="#402EE8D6">
                                <TextBlock Text="↑ объём данных" FontSize="10" Foreground="#7EEADB"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Links -->
                <Border x:Name="StatLinksCard" Margin="0,0,14,0" CornerRadius="20" BorderThickness="1" BorderBrush="#35FF7EB3"
                        Background="{StaticResource StatCardPinkBrush}" Padding="22" ClipToBounds="True"
                        helpers:Animation.InteractiveGlow="True"
                        helpers:Animation.InteractiveGlowColor="#FF7EB3"
                        helpers:Animation.InteractiveGlowSecondaryColor="#FFB3D0"
                        helpers:Animation.StaggerIndex="4"
                        helpers:Animation.Entrance="SlideUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25" Color="#FF7EB3"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Width="90" Height="90" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-20,-20" Fill="#15FF7EB3"/>
                        <StackPanel>
                            <Path Style="{StaticResource StatIconPath}"
                                  Data="{StaticResource LinkIconGeometry}"
                                  Stroke="{StaticResource AccentWarmBrush}"/>
                            <TextBlock Text="Ссылок сгенерировано" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LinksGenerated}" FontSize="38" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource AccentWarmBrush}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource TrendBadge}" Background="#1AFF7EB3" BorderBrush="#40FF7EB3">
                                <TextBlock Text="↑ охват карт" FontSize="10" Foreground="#FFB3D0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sessions -->
                <Border x:Name="StatSessionsCard" CornerRadius="20" BorderThickness="1" BorderBrush="#353EE8A0"
                        Background="{StaticResource StatCardGreenBrush}" Padding="22" ClipToBounds="True"
                        helpers:Animation.InteractiveGlow="True"
                        helpers:Animation.InteractiveGlowColor="#3EE8A0"
                        helpers:Animation.InteractiveGlowSecondaryColor="#7EE8B8"
                        helpers:Animation.StaggerIndex="5"
                        helpers:Animation.Entrance="SlideUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25" Color="#3EE8A0"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,0,-10,-10" Fill="#123EE8A0"/>
                        <StackPanel>
                            <Path Style="{StaticResource StatIconPath}"
                                  Data="{StaticResource BoltIconGeometry}"
                                  Stroke="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Сессий генерации" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LinkSessions}" FontSize="38" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,10"/>
                            <Border Style="{StaticResource TrendBadge}">
                                <TextBlock Text="● стабильно" FontSize="10" Foreground="#7EE8B8"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Chart + Insights row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Chart -->
                <Border Grid.Column="0" Style="{StaticResource PremiumGlassCard}" MinHeight="340" Padding="20"
                        helpers:Animation.StaggerIndex="6"
                        helpers:Animation.Entrance="SlideLeft">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Динамика активности"/>
                                <TextBlock Text="Строки · Ссылки · Файлы по дням" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="Live chart" FontSize="10" Foreground="{StaticResource AccentSecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <oxy:PlotView x:Name="ActivityPlotView" Grid.Row="1"
                                      Model="{Binding ActivityChart}" Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Insights panel (decorative + real metric) -->
                <Border Grid.Column="2" Style="{StaticResource PremiumGlassCard}" Padding="20"
                        helpers:Animation.StaggerIndex="7"
                        helpers:Animation.Entrance="SlideRight">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Insights" Margin="0,0,0,4"/>
                        <TextBlock Text="Сводка пайплайна" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                        <!-- Pipeline efficiency (decorative) -->
                        <TextBlock Text="Эффективность пайплайна" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6" Height="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="87*"/>
                                <ColumnDefinition Width="13*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B6CFF" Offset="0"/>
                                        <GradientStop Color="#2EE8D6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Grid.Column="1" Background="#12FFFFFF" CornerRadius="0,4,4,0"/>
                        </Grid>
                        <TextBlock Text="87% — отличный результат" FontSize="11"
                                   Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,0,20"/>

                        <!-- Real duplicates metric -->
                        <Border Background="#0AFFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Дубликатов удалено" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DuplicatesRemoved}" FontSize="24" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Decorative metrics -->
                        <Border Background="#0AFFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Городов в базе" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="43" FontSize="24" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Path Data="{StaticResource GlobeIconGeometry}"
                                      Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{StaticResource AccentPrimaryBrush}"
                                      StrokeThickness="1.6" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#0AFFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Ср. время обработки" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="~2.4 сек" FontSize="24" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentGoldBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Path Data="{StaticResource StopwatchIconGeometry}"
                                      Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{StaticResource AccentGoldBrush}"
                                      StrokeThickness="1.6" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#0AFFFFFF" CornerRadius="12" Padding="14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Качество данных" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="96.2%" FontSize="24" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Path Data="{StaticResource CheckIconGeometry}"
                                      Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{StaticResource SuccessBrush}"
                                      StrokeThickness="2" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7EB3" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Последняя активность" Margin="0,0,0,16"
                       helpers:Animation.StaggerIndex="8"
                       helpers:Animation.Entrance="SlideUp"/>
            <Border Style="{StaticResource PremiumGlassCard}"
                    helpers:Animation.StaggerIndex="9"
                    helpers:Animation.Entrance="SlideUp">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#08FFFFFF" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                Background="#158B6CFF" VerticalAlignment="Center">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  Stroke="#C4B5FD" StrokeThickness="1.6" Fill="Transparent"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="{Binding Type, Converter={StaticResource ActivityIconGeometryConverter}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} шт.'}"
                                                   Foreground="{StaticResource AccentSecondaryBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="16,0"/>
                                        <Border Grid.Column="3" CornerRadius="8" Padding="10,5" VerticalAlignment="Center"
                                                Background="#158B6CFF" BorderBrush="#308B6CFF" BorderThickness="1">
                                            <TextBlock Text="{Binding Type}" Foreground="#B8A8FF" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#08FFFFFF" CornerRadius="12" Padding="24"
                            Visibility="{Binding RecentActivity.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource SparklesIconGeometry}"
                                  Width="36" Height="36" Stretch="Uniform"
                                  Stroke="{StaticResource AccentPrimaryBrush}"
                                  StrokeThickness="1.4" Fill="Transparent"
                                  HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Пока нет активности"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Начните с обработки лидов или генерации ссылок"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
