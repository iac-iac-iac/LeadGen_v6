<UserControl x:Class="LeadGen.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LeadGen.Helpers"
             Loaded="OnLoaded"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">
    <Grid MaxWidth="1280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28"
              helpers:Animation.StaggerIndex="0"
              helpers:Animation.Entrance="BlurReveal">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Обработка лидов"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Загрузка Webbee AI → очистка → экспорт в Битрикс24"/>
            </StackPanel>
            <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="Pipeline · 3 этапа" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Импорт файлов -->
            <Border Grid.Column="0" Style="{StaticResource PremiumGlassCard}" MinHeight="420"
                    helpers:Animation.StaggerIndex="1"
                    helpers:Animation.Entrance="SlideLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Зона drop (компактная, не перекрывается списком) -->
                    <Border x:Name="DropZone" Grid.Row="0"
                            BorderBrush="#508B6CFF" BorderThickness="1.5"
                            CornerRadius="14" Background="#0A8B6CFF"
                            Padding="20,18" Margin="0,0,0,16"
                            MouseLeftButtonUp="OnDropZoneClick" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#508B6CFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#808B6CFF"/>
                                        <Setter Property="Background" Value="#128B6CFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                    Background="#158B6CFF" BorderBrush="#308B6CFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="28" FontWeight="Light" Foreground="#C4B5FD"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Добавить файлы" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Перетащите сюда или нажмите для выбора"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="#122EE8D6" BorderBrush="#302EE8D6" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="JSON" FontSize="9" FontWeight="SemiBold" Foreground="#7EEADB"/>
                                    </Border>
                                    <Border Background="#158B6CFF" BorderBrush="#308B6CFF" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="TSV" FontSize="9" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                                    </Border>
                                    <Border Background="#15FF7EB3" BorderBrush="#30FF7EB3" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="CSV" FontSize="9" FontWeight="SemiBold" Foreground="#FFB3D0"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Drop" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#408B6CFF" VerticalAlignment="Center"
                                       Visibility="{Binding LoadedFiles.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Заголовок списка -->
                    <Grid Grid.Row="1" Margin="0,0,0,10"
                          Visibility="{Binding LoadedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Загруженные файлы" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#158B6CFF" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding LoadedFiles.Count}" FontSize="11" FontWeight="Bold"
                                           Foreground="#C4B5FD"/>
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="Очистить всё"
                                HorizontalAlignment="Right" Padding="12,6" FontSize="11"
                                Command="{Binding ClearFilesCommand}"/>
                    </Grid>

                    <!-- Список файлов -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding LoadedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl x:Name="FilesList" ItemsSource="{Binding LoadedFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ImportFileRow}" ToolTip="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                    Background="#12101828" BorderBrush="#28252B3D" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={StaticResource FileExtensionConverter}}"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6" FontSize="10" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Пустое состояние под drop-зоной -->
                    <Border Grid.Row="2" Background="#06FFFFFF" CornerRadius="12"
                            BorderBrush="#18252B3D" BorderThickness="1"
                            Visibility="{Binding LoadedFiles.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="Файлы не выбраны" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Добавьте экспорт Webbee AI для начала обработки"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Actions panel -->
            <Border Grid.Column="2" Style="{StaticResource PremiumGlassCard}"
                    helpers:Animation.StaggerIndex="2"
                    helpers:Animation.Entrance="SlideRight">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Настройки" Margin="0,0,0,4"/>
                    <TextBlock Text="Параметры обработки и экспорта" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="Менеджеры" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="По одному имени на строку (необязательно)"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBox}" AcceptsReturn="True"
                             Text="{Binding ManagersText, UpdateSourceTrigger=PropertyChanged}"
                             Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить и объединить"
                            Command="{Binding ProcessFilesCommand}" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Экспорт в Битрикс"
                            Command="{Binding ExportBitrixCommand}"
                            IsEnabled="{Binding CanExport}" Margin="0,0,0,24"/>

                    <Border Background="#08FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Этапы пайплайна" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#158B6CFF" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock Text="1. Загрузка" FontSize="10" Foreground="#C4B5FD"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="#122EE8D6" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock Text="2. Очистка" FontSize="10" Foreground="#7EEADB"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="#15FF7EB3" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="3. Экспорт" FontSize="10" Foreground="#FFB3D0"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#08FFFFFF" CornerRadius="12" Padding="16">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
