<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:LeadGen.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, monospace</FontFamily>

