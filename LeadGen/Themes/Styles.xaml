    <Geometry x:Key="CheckIconGeometry">M5,12 L10,17 L19,7</Geometry>
    <Geometry x:Key="SparklesIconGeometry">M12,2 L13,8 L19,9 L13,10 L12,16 L11,10 L5,9 L11,8 Z M4,4 L4.5,6 L6.5,6.5 L4.5,7 L4,9 L3.5,7 L1.5,6.5 L3.5,6 Z M20,16 L20.5,18 L22.5,18.5 L20.5,19 L20,21 L19.5,19 L17.5,18.5 L19.5,18 Z</Geometry>
