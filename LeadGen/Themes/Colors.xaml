<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Obsidian Intelligence — глубокая тёмная палитра с aurora-акцентами -->
    <Color x:Key="BgDeep">#06070D</Color>
    <Color x:Key="BgSurface">#0E1018</Color>
    <Color x:Key="BgCard">#141824</Color>
    <Color x:Key="BgCardHover">#1A2030</Color>
    <Color x:Key="AccentPrimary">#8B6CFF</Color>
    <Color x:Key="AccentSecondary">#2EE8D6</Color>
    <Color x:Key="AccentWarm">#FF7EB3</Color>
    <Color x:Key="AccentGold">#F5C842</Color>
    <Color x:Key="TextPrimary">#F4F6FF</Color>
    <Color x:Key="TextSecondary">#8E97B0</Color>
    <Color x:Key="TextMuted">#5C6478</Color>
    <Color x:Key="BorderSubtle">#252B3D</Color>
    <Color x:Key="BorderGlow">#408B6CFF</Color>
    <Color x:Key="Success">#3EE8A0</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}"/>
    <SolidColorBrush x:Key="AccentWarmBrush" Color="{StaticResource AccentWarm}"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>

    <!-- Фон приложения -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06070D" Offset="0"/>
        <GradientStop Color="#0C1020" Offset="0.45"/>
        <GradientStop Color="#080A12" Offset="1"/>
    </LinearGradientBrush>

    <!-- Aurora orbs для декора -->
    <RadialGradientBrush x:Key="AuroraOrbPurpleBrush" GradientOrigin="0.3,0.3">
        <GradientStop Color="#558B6CFF" Offset="0"/>
        <GradientStop Color="#008B6CFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraOrbTealBrush" GradientOrigin="0.7,0.3">
        <GradientStop Color="#402EE8D6" Offset="0"/>
        <GradientStop Color="#002EE8D6" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraOrbPinkBrush" GradientOrigin="0.5,0.5">
        <GradientStop Color="#35FF7EB3" Offset="0"/>
        <GradientStop Color="#00FF7EB3" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B6CFF" Offset="0"/>
        <GradientStop Color="#2EE8D6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroTitleGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4F6FF" Offset="0"/>
        <GradientStop Color="#C4B5FD" Offset="0.5"/>
        <GradientStop Color="#2EE8D6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatCardPurpleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1228" Offset="0"/>
        <GradientStop Color="#12182A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardTealBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E1A22" Offset="0"/>
        <GradientStop Color="#101828" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardPinkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1018" Offset="0"/>
        <GradientStop Color="#181020" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardGreenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E1A16" Offset="0"/>
        <GradientStop Color="#101820" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavActiveGlowBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#558B6CFF" Offset="0"/>
        <GradientStop Color="#332EE8D6" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" x:Shared="False" BlurRadius="40" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="GlowAccent" x:Shared="False" BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#8B6CFF"/>
    <DropShadowEffect x:Key="GlowTeal" x:Shared="False" BlurRadius="24" ShadowDepth="0" Opacity="0.4" Color="#2EE8D6"/>
    <DropShadowEffect x:Key="SoftGlow" x:Shared="False" BlurRadius="60" ShadowDepth="0" Opacity="0.35" Color="#8B6CFF"/>

</ResourceDictionary>
